aws_region  = "us-east-1"
name_prefix = "ntier-dev"
vpc_cidr    = "10.0.0.0/16"

# t4g.micro — nano often OOMs on cloud-init dnf (iptables missing → EKS nodes fail to join).
nat_instance_type = "t4g.micro"

# Do not put my_ip here. Pass it at apply time (see README).
kubernetes_version     = "1.35"
eks_node_instance_type = "t4g.small"

enable_alb = true

# Single switch. false = ALB session (no Postgres). true = RDS + per-tenant secrets + IRSA.
# After flipping, apply again, then re-run: tofu output -raw helm_install
enable_rds = false

# Pooled tenant keys. IAM/secrets when enable_rds; ALB /tenant-<id>* and NodePort 30080+index always.
# First id runs the RLS migrate Job. To add a tenant: append an id, apply, then onboard_tenant.py
# (README — Add a tenant).
tenant_ids = ["a", "b", "c"]

# Phase A shared Ingress (ALB controller). Use "nodeport" for legacy OpenTofu ALB.
ingress_mode = "alb_controller"
# t4g.medium: ~17 pods; t4g.small max 11 is too tight with LBC + 5 tenants.
# eks_node_instance_type = "t4g.medium"

# false = control plane owns SM/IRSA; true = OpenTofu for_each on tenant_ids
manage_tenant_identity = false
platform_tenant_id     = "a"
tenant_ids             = []
