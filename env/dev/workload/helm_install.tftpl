set -euo pipefail
aws eks update-kubeconfig --name ${cluster_name} --region ${region}
kubectl wait --for=condition=Ready nodes --all --timeout=600s

helm upgrade --install fluent-bit ${fluent_chart} \
  --namespace amazon-cloudwatch --create-namespace \
  --set region=${region} \
  --set logGroup=${log_group} \
  --set-json 'serviceAccount.annotations={"eks.amazonaws.com/role-arn":"${fluent_bit_role}"}'
kubectl -n amazon-cloudwatch rollout status daemonset/fluent-bit --timeout=180s

%{ if use_controller ~}
helm repo add eks https://aws.github.io/eks-charts 2>/dev/null || true
helm repo update eks
helm upgrade --install aws-load-balancer-controller eks/aws-load-balancer-controller \
  --namespace kube-system \
  --set clusterName=${cluster_name} \
  --set region=${region} \
  --set vpcId=${vpc_id} \
  --set replicaCount=1 \
  --set serviceAccount.create=true \
  --set serviceAccount.name=aws-load-balancer-controller \
  --set-json 'serviceAccount.annotations={"eks.amazonaws.com/role-arn":"${lbc_role_arn}"}'
kubectl -n kube-system rollout status deploy/aws-load-balancer-controller --timeout=300s
%{ endif ~}

%{ if enable_rds ~}
export MY_IP="$(curl -sS https://checkip.amazonaws.com)/32"
python3 ${onboard} --all --tofu-dir .
%{ for tid in tenant_ids ~}
kubectl -n tenant-${tid} rollout status deploy/test-app --timeout=300s
%{ endfor ~}
ALB_URL="$(cat .alb_url 2>/dev/null || true)"
if [ -z "$${ALB_URL}" ]; then
  ALB_URL='${alb_url}'
fi
%{ for tid in tenant_ids ~}
curl -sS "$${ALB_URL}/tenant-${tid}/health" || true
echo
%{ endfor ~}
echo "CloudWatch Logs: ${log_group}  Insights: stats count(*) by tenant_id"
echo "ALB: $${ALB_URL}"
%{ else ~}
helm upgrade --install test-app ${chart} --namespace default \
  --set fullnameOverride=test-app \
  --set serviceAccount.name=test-app \
  --set database.enabled=false \
  --set tenant.id=lab \
  --set pathPrefix=/tenant-${first_tenant} \
%{ if use_controller ~}
  --set service.type=ClusterIP \
  --set ingress.enabled=true \
  --set ingress.groupName=${alb_ingress_group} \
%{ else ~}
  --set service.type=NodePort \
  --set service.nodePort=${first_node_port} \
  --set ingress.enabled=false \
%{ endif ~}
  --set region=${region}
kubectl -n default rollout status deploy/test-app --timeout=180s
echo "CloudWatch Logs: ${log_group}  Insights: stats count(*) by tenant_id"
%{ endif ~}
