set -euo pipefail
aws eks update-kubeconfig --name ${cluster_name} --region ${region}
kubectl wait --for=condition=Ready nodes --all --timeout=600s

helm upgrade --install fluent-bit ${fluent_chart} \
  --namespace amazon-cloudwatch --create-namespace \
  --set region=${region} \
  --set logGroup=${log_group} \
  --set-json 'serviceAccount.annotations={"eks.amazonaws.com/role-arn":"${fluent_bit_role}"}'
kubectl -n amazon-cloudwatch rollout status daemonset/fluent-bit --timeout=180s

%{ if enable_rds ~}
python3 ${onboard} --all --tofu-dir .
%{ for tid in tenant_ids ~}
kubectl -n tenant-${tid} rollout status deploy/test-app --timeout=300s
curl -s ${alb_url}/tenant-${tid}/health
echo
%{ endfor ~}
echo "CloudWatch Logs: ${log_group}  Insights: stats count(*) by tenant_id"
%{ else ~}
helm upgrade --install test-app ${chart} --namespace default \
  --set fullnameOverride=test-app \
  --set serviceAccount.name=test-app \
  --set database.enabled=false \
  --set tenant.id=lab \
  --set pathPrefix=/tenant-${first_tenant} \
  --set service.type=NodePort \
  --set service.nodePort=${first_node_port} \
  --set region=${region}
kubectl -n default rollout status deploy/test-app --timeout=180s
curl -s ${alb_url}/tenant-${first_tenant}/health
echo
echo "CloudWatch Logs: ${log_group}  Insights: stats count(*) by tenant_id"
%{ endif ~}
